@{
    ViewData["Title"] = "Login";
}
<style>
    .auth-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        padding: 48px;
    }

    .auth-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 38px;
        font-weight: 300;
        line-height: 1;
        margin-bottom: 6px;
    }

        .auth-title em {
            font-style: italic;
            color: var(--accent);
        }

    .auth-sub {
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 36px;
    }

    .auth-footer {
        margin-top: 24px;
        text-align: center;
        font-size: 11px;
        color: var(--text-muted);
    }

        .auth-footer a {
            color: var(--accent);
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }

    .error-msg {
        background: rgba(160,80,80,0.15);
        border: 1px solid rgba(160,80,80,0.3);
        color: #e08080;
        padding: 10px 14px;
        border-radius: var(--radius);
        font-size: 12px;
        margin-bottom: 20px;
    }

    .remember-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .remember-check {
        width: auto !important;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .divider-or {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: var(--text-muted);
        font-size: 10px;
        letter-spacing: 0.1em;
    }

        .divider-or::before, .divider-or::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Welcome <em>Back</em></h1>
        <p class="auth-sub">Sign in to your account</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-msg">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/Account/Login">

            <div class="form-group">
                <label>Email Address</label>
                <input type="text" name="Email" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="Password" placeholder="••••••••" />
            </div>

            <div class="remember-row">
                <input type="checkbox" name="RememberMe" value="true" id="remMe" class="remember-check" />
                <label for="remMe" style="margin:0; cursor:pointer; color:var(--text-muted);">
                    Remember me for 30 days
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
                Sign In
            </button>

        </form>

        <div class="divider-or">or</div>

        <div class="auth-footer">
            Don't have an account?
            <a href="/Account/Register">Create one</a>
        </div>
    </div>
</div>