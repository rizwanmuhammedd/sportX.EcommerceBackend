@model GalleryApp.Models.Photo
@{
    ViewData["Title"] = "Edit Photo";
}
<style>
    .edit-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 44px;
        font-weight: 300;
        line-height: 1;
        margin-bottom: 8px;
    }
    .edit-title em {
        font-style: italic;
        color: var(--accent);
    }
    .edit-id {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 36px;
    }
    .edit-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        max-width: 960px;
    }
    .current-image {
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--border);
        background: var(--surface);
    }
    .current-image img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        display: block;
    }
    .img-label {
        padding: 12px 16px;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
    }
    .note-box {
        margin-top: 16px;
        padding: 14px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-size: 12px;
        color: var(--text-muted);
        line-height: 1.6;
    }
    .owner-info {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: var(--accent-dim);
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        margin-bottom: 24px;
    }
    .owner-info-text {
        font-size: 11px;
        color: var(--accent);
    }
    .divider {
        height: 1px;
        background: var(--border);
        margin: 22px 0;
    }
    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }
    .hint {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 5px;
        opacity: 0.6;
    }
    select { cursor: pointer; }
</style>

<a class="btn" href="/Gallery/Details/@Model.Id" style="margin-bottom:28px;display:inline-flex;">← Back</a>

<h1 class="edit-title"><em>Edit</em> Photo</h1>
<p class="edit-id">ID #@Model.Id &nbsp;·&nbsp; @Model.ViewCount views</p>

<div class="edit-layout">
    <div>
        <div class="owner-info">
            <div class="owner-info-text">You are editing your own photo</div>
        </div>
        <div style="font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;">Current Image</div>
        <div class="current-image">
            <img src="@Model.ImagePath" alt="Current photo" />
            <div class="img-label">
                <span>@System.IO.Path.GetFileName(Model.ImagePath ?? "")</span>
                <span style="color:var(--accent)">Stored</span>
            </div>
        </div>
        <div class="note-box">To replace the image, delete this photo and upload a new one.</div>
    </div>

    <div>
        <form method="post" action="/Gallery/Edit">
            <input type="hidden" name="Id"           value="@Model.Id" />
            <input type="hidden" name="ImagePath"    value="@Model.ImagePath" />
            <input type="hidden" name="CreatedDate"  value="@Model.CreatedDate.ToString("o")" />
            <input type="hidden" name="ViewCount"    value="@Model.ViewCount" />
            <input type="hidden" name="UserId"       value="@Model.UserId" />
            <input type="hidden" name="UploaderEmail" value="@Model.UploaderEmail" />

            <div class="form-group">
                <label>Photo Title</label>
                <input type="text" name="Title" value="@Model.Title"
                       placeholder="Give this photo a title..." maxlength="100" />
                <div class="hint">Maximum 100 characters</div>
            </div>

            <div class="form-group">
                <label>Category</label>
                <select name="Category">
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in new[] { "Nature", "Travel", "Portrait", "Architecture", "Food", "Abstract", "Street", "Other" })
                    {
                        <option value="@cat" @(Model.Category == cat ? "selected" : "")>@cat</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="Description" placeholder="Describe this photo..."
                          maxlength="500" style="min-height:110px;">@Model.Description</textarea>
                <div class="hint">Maximum 500 characters</div>
            </div>

            <div class="divider"></div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Gallery/Details/@Model.Id" class="btn">Cancel</a>
                <a href="/Gallery/Delete/@Model.Id" class="btn btn-danger"
                   onclick="return confirm('Delete your photo permanently?')">Delete</a>
            </div>
        </form>
    </div>
</div>